<!-- views/layouts/admin-layout.ejs -->

<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('../partials/header') %>
    <link rel="stylesheet" href="/css/theme.css?v=1.0.3">

    <!-- DATA ISLAND for admin pages -->
    <script>
      window.APP_DATA = {
          user: <%- JSON.stringify(user || null) %>
      };
    </script>
  </head>
  <body class="admin-theme has-solid-nav">
    <!-- Include the navbar -->
    <<%- include('../partials/navbar', { solidNavbar: true, isAdmin: true }) %>

    <main>
        <%- body %>
    </main>
    <!-- Include the shared footer with all the Alpine.js components -->
    <%- include('../partials/footer') %>

    <!-- Modals and Toasts -->
    <div
      x-data="notificationModal"
      x-show="isOpen"
      @keydown.escape.window="close()"
      x-transition:enter="alpine-fade"
      x-transition:leave="alpine-fade"
      class="modal-backdrop"
    >
      <div class="modal-content" @click.outside="close()">
        <h3 x-text="title"></h3>
        <p x-text="message"></p>
        <button @click="close()" class="modal-close-btn">Close</button>
      </div>
    </div>

    <div
      x-data="toast"
      x-show="isVisible"
      x-transition:enter-start="opacity-0 transform translate-x-full"
      x-transition:enter-end="opacity-100 transform translate-x-0"
      x-transition:leave-start="opacity-100 transform translate-x-0"
      x-transition:leave-end="opacity-0 transform translate-x-full"
      @click="close()"
      class="toast-container"
    >
      <p x-text="message"></p>
    </div>
  </body>
</html>
