    <%- include('../partials/header') %>

        <link rel="stylesheet" href="/css/theme.css?v=1.0.1">
    <script>
      window.APP_DATA = {
          user: <%- JSON.stringify(user || null) %>,
          STRIPE_PUBLISHABLE_KEY: <%- JSON.stringify(STRIPE_PUBLISHABLE_KEY || null) %>
      };
    </script>

  </head>
  <<body class="<% if (locals.solidNavbar) { %>has-solid-nav<% } %>">
    
    <%- include('../partials/navbar', { solidNavbar: locals.solidNavbar }) %>

