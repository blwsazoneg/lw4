<% layout('layouts/app-layout') %>

<div class="container mt-4" x-data="innovationForm(APP_DATA.user)">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <header class="mb-4 text-center">
                <h1 class="h2">Submit Your Idea or Innovation</h1>
                <p class="lead text-muted">Share your concepts for new projects, improvements, or ministry-focused initiatives.</p>
            </header>

            <template x-if="!isLoggedIn">
                <div class="card card-body bg-light text-center p-4 p-md-5">
                    <h2>Please Log In</h2>
                    <p>You must be logged in to submit an idea. Please connect with your KingsChat account to continue.</p>
                    <div x-data="kingsChatLogin" x-init="setRedirect('/innovate')">
                         <a @click="handleLogin()" class="btn btn-primary btn-lg">Connect with KingsChat</a>
                    </div>
                </div>
            </template>

            <template x-if="isLoggedIn">
                <div class="card card-body">
                    <form @submit.prevent="submitIdea" enctype="multipart/form-data">
                        <div class="mb-3">
                            <label for="title" class="form-label">Title of Your Idea</label>
                            <input type="text" id="title" class="form-control" x-model="formData.title" required>
                        </div>
                        <div class="mb-3">
                            <label for="submission_text" class="form-label">Describe Your Idea</label>
                            <textarea id="submission_text" class="form-control" x-model="formData.submission_text" rows="8" required></textarea>
                        </div>
                        <div class="mb-3">
                            <label for="ministry_position" class="form-label">Relevant Ministry Position (Optional)</label>
                            <select id="ministry_position" class="form-select" x-model="formData.ministry_position"><option value="">-- Select --</option><option>Pastor</option><option>Deacon/Deaconess</option><option>Cell Leader</option><option>PCF Leader</option><option>Church Staff</option><option>Usher</option><option>Chorister</option><option>Member</option></select>
                        </div>
                        <hr class="my-4">
                        <h5>Optional Attachments</h5>
                        <div class="row g-3">
                            <div class="col-md-4"><label for="document" class="form-label">Document</label><input type="file" id="document" class="form-control" x-ref="documentInput" accept=".pdf,.doc,.docx"></div>
                            <div class="col-md-4"><label for="photos" class="form-label">Photos</label><input type="file" id="photos" class="form-control" x-ref="photosInput" accept="image/*" multiple></div>
                            <div class="col-md-4"><label for="video" class="form-label">Video</label><input type="file" id="video" class="form-control" x-ref="videoInput" accept="video/*"></div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary" :disabled="isSubmitting">
                                <span x-show="!isSubmitting">Submit Idea</span>
                                <span x-show="isSubmitting" class="spinner-border spinner-border-sm"></span>
                            </button>
                        </div>
                    </form>
                </div>
            </template>
        </div>
    </div>
</div>