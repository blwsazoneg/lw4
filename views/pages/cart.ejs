<% layout('layouts/mainLayout') %>

<div class="container" x-data="shoppingCart" x-init="fetchCartItems()">
  <h1>Your Shopping Cart</h1>

  <!-- Loading State -->
  <div x-show="isLoading" class="loading"><p>Loading your cart...</p></div>

  <!-- Error State -->
  <div x-show="error" class="error-message"><p x-text="error"></p></div>

  <!-- Main Cart Content -->
  <div x-show="!isLoading && !error">
    <!-- STATE 1: Cart is Empty -->
    <template x-if="items.length === 0">
      <div class="cart-empty">
        <p>Your shopping cart is empty.</p>
        <a href="/shop" class="feature-btn">Continue Shopping</a>
      </div>
    </template>

    <!-- STATE 2: Cart has items -->
    <template x-if="items.length > 0">
      <div class="cart-container">
        <!-- Cart Items List -->
        <div class="cart-items-list">
          <template x-for="item in items" :key="item.product_id">
            <div class="cart-item">
              <img
                :src="item.image_url"
                alt="Product Image"
                class="cart-item-image"
              />
              <div class="cart-item-details">
                <h3 x-text="item.name"></h3>
                <!-- We will add quantity controls later -->
                <p x-text="`Quantity: ${item.quantity}`"></p>
              </div>
              <div class="cart-item-price">
                <p x-text="formatCurrency(item.price * item.quantity)"></p>
                <button
                  @click="removeItem(item.product_id)"
                  class="remove-item-btn"
                >
                  Remove
                </button>
              </div>
            </div>
          </template>
        </div>

        <!-- Cart Summary -->
        <div class="cart-summary">
          <h2>Order Summary</h2>
          <div class="summary-line">
            <span>Subtotal</span>
            <span x-text="formatCurrency(subtotal)"></span>
          </div>
          <div class="summary-line">
            <span>Shipping</span>
            <span>FREE</span>
          </div>
          <hr />
          <div class="summary-line total">
            <span>Total</span>
            <span x-text="formatCurrency(subtotal)"></span>
          </div>
          <!-- <button
            @click="checkout()"
            class="checkout-btn"
            :disabled="isCheckingOut"
          >
            <span x-show="!isCheckingOut">Proceed to Checkout</span>
            <span x-show="isCheckingOut">Processing...</span>
          </button> -->

          <!-- ============================================= -->
          <!-- STRIPE INTEGRATION - This part is new         -->
          <!-- ============================================= -->
          <!-- The Stripe Payment Element will be injected here -->
          <div id="payment-element" class="stripe-element"></div>

          <!-- This button will trigger the Stripe payment flow -->
          <button
            @click="checkout()"
            class="checkout-btn"
            :disabled="isCheckingOut"
          >
            <span x-show="!isCheckingOut">Pay Now</span>
            <span x-show="isCheckingOut">Processing Payment...</span>
          </button>
          <!-- An element to display messages from Stripe -->
          <div id="payment-message" class="hidden stripe-message"></div>
          
        </div>
      </div>
    </template>
  </div>
</div>
