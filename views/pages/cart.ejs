<% layout('layouts/app-layout') %>

<!-- This page-specific script tag is essential for Stripe.js -->
<head>
    <script src="https://js.stripe.com/v3/"></script>
</head>

<div class="container mt-4" x-data="shoppingCart" x-init="init()">
    <header class="mb-4">
        <h1 class="h2">Your Shopping Cart</h1>
    </header>

    <div x-show="isLoading" class="text-center p-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>
    <div x-show="error" class="alert alert-danger" x-text="error"></div>

    <div x-show="!isLoading && !error">
        <template x-if="items.length === 0">
            <div class="card card-body bg-light text-center p-5">
                <p class="lead">Your shopping cart is empty.</p>
                <div class="mt-3">
                    <a href="/shop" class="btn btn-primary">Continue Shopping</a>
                </div>
            </div>
        </template>

        <template x-if="items.length > 0">
            <div class="row g-4">
                <!-- Left Column: Cart Items -->
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                <template x-for="item in items" :key="item.product_id">
                                    <li class="list-group-item d-flex align-items-center gap-3 py-3">
                                        <img :src="item.image_url || '/images/placeholder.png'" alt="..." width="80" height="80" class="rounded">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1" x-text="item.name"></h6>
                                            <p class="mb-1 text-muted" x-text="`Quantity: ${item.quantity}`"></p>
                                            <button @click="removeItem(item.product_id)" class="btn btn-sm btn-outline-danger mt-1">Remove</button>
                                        </div>
                                        <div class="text-end fw-bold">
                                            <span x-text="formatCurrency(item.price * item.quantity)"></span>
                                        </div>
                                    </li>
                                </template>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Right Column: Order Summary -->
                <div class="col-lg-4">
                    <div class="card card-body bg-light sticky-top" style="top: 100px;">
                        <h5 class="card-title">Order Summary</h5>
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item d-flex justify-content-between bg-transparent px-0"><span>Subtotal</span><span x-text="formatCurrency(subtotal)"></span></li>
                            <li class="list-group-item d-flex justify-content-between bg-transparent px-0"><span>Shipping</span><span>FREE</span></li>
                            <li class="list-group-item d-flex justify-content-between bg-transparent px-0 border-top pt-3"><strong>Total</strong><strong x-text="formatCurrency(subtotal)"></strong></li>
                        </ul>
                        
                        <hr class="my-3">

                        <div id="payment-element"></div>
                        <button @click="checkout()" class="btn btn-success btn-lg w-100 mt-3" :disabled="isCheckingOut || !clientSecret">
                            <span x-show="!isCheckingOut">Pay Now</span>
                            <span x-show="isCheckingOut" class="spinner-border spinner-border-sm"></span>
                        </button>
                        <div id="payment-message" class="mt-2 text-danger text-center small"></div>
                    </div>
                </div>
            </div>
        </template>
    </div>
</div>