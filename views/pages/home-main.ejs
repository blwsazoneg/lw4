<% layout('layouts/app-layout') %>

<div class="home-main-container">
  <!-- Hero Section -->
  <header class="hero-section">
    <div class="hero-content">
      <h1>Explore Loveworld 4.0</h1>
    </div>
  </header>

  <!-- Info Cards Section -->
  <section class="info-cards-section">
    <div class="info-card">
      <div class="card-icon-wrapper">
        <img src="/images/espees.png" alt="Espees Icon" class="card-icon" />
      </div>
      <h2>Business is better with Espees</h2>
      <p>
        Conduct business transactions with Espees. Espees are proven stable and
        reliable, with an upward value trajectory, making it far more dependable
        than other currencies.
      </p>
      <a href="#" class="card-btn">Business with Espees</a>
    </div>

    <div class="info-card">
      <div class="card-icon-wrapper">
        <img
          src="/images/lw4.png"
          alt="Made in Loveworld Icon"
          class="card-icon"
        />
      </div>
      <h2>Everything is Made in Loveworld</h2>
      <p>
        Your shopping dream come true is just a click away. You think it, we got
        it.
      </p>
      <a href="/shop" class="card-btn">Shop</a>
    </div>

    <div class="info-card">
      <div class="card-icon-wrapper icon-red-bg">
        <img src="/images/icon-sbo.png" alt="SBO Icon" class="card-icon" />
      </div>
      <h2>Discover a world of opportunities</h2>
      <p>
        ...at any of our strategic business organisations. Get a strategic
        placement today.
      </p>
      <a href="/jobs" class="card-btn">Get Discovered</a>
    </div>
  </section>
</div>
