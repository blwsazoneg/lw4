<% layout('layouts/app-layout') %>

<div class="container mt-4" x-data="jobBoard(APP_DATA.user)" x-init="init()">
    <header class="mb-4">
        <h1>Work at an SBO</h1>
        <p class="lead text-muted">Browse and apply for opportunities that match your skills and passion.</p>
    </header>

    <!-- Unified Search Control -->
    <div class="card card-body bg-light mb-4">
        <div class="form-group">
            <label for="search" class="form-label fw-bold">Search by Role, Organization, or Tag</label>
            <input type="text" id="search" class="form-control form-control-lg" x-model.debounce.300ms="searchQuery" placeholder="e.g., developer, Innovate Inc., admin">
        </div>
    </div>

    <!-- Loading State -->
    <div x-show="isLoading" class="text-center p-5">
        <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>

    <!-- Main Job Listings -->
    <div x-show="!isLoading">
        <!-- 
            Bootstrap's responsive grid:
            - row-cols-1: 1 column on extra-small screens
            - row-cols-md-2: 2 columns on medium screens (tablets) and up
            - row-cols-lg-3: 3 columns on large screens (desktops) and up
            - g-4: Sets a nice gap between the cards
        -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            <template x-for="job in jobs" :key="job.id">
                <div class="col">
                    <!-- Bootstrap Card Component -->
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title" x-text="job.title"></h5>
                            <h6 class="card-subtitle mb-2 text-muted" x-text="job.company_name"></h6>
                            <p class="card-text small text-muted" x-text="job.location"></p>
                            
                            <!-- Tags -->
                            <div class="d-flex flex-wrap gap-2 mb-3">
                                <template x-for="tag in job.tags" :key="tag">
                                    <span class="badge bg-secondary fw-normal" x-text="tag"></span>
                                </template>
                            </div>

                            <!-- Button pushed to the bottom -->
                            <div class="mt-auto">
                                <a href="#" @click.prevent="handleViewAndApply(job.id)" class="btn btn-primary w-100">
                                    View & Apply
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <!-- Message if no jobs match the filter -->
        <div x-show="jobs.length === 0" class="alert alert-info mt-4">
            No jobs found matching your criteria.
        </div>
    </div>
</div>