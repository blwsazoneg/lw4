<% layout('layouts/app-layout') %>

<div class="container mt-4" x-data="orderHistory" x-init="init()">
    <header class="mb-4">
        <h1 class="h2">Your Orders</h1>
    </header>

    <div class="card card-body bg-light mb-4">
        <div class="form-group">
            <label for="search" class="form-label">Search by Order Number</label>
            <input type="text" id="search" class="form-control" x-model.debounce.500ms="searchQuery" placeholder="Enter order #...">
        </div>
    </div>

    <div x-show="isLoading" class="text-center p-5">
        <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
    </div>

    <div x-show="!isLoading && !error">
        <template x-if="orders.length === 0">
            <div class="alert alert-info">
                <p x-show="searchQuery">No orders found matching your search.</p>
                <p x-show="!searchQuery">You have not placed any orders yet.</p>
                <a href="/shop" class="btn btn-primary mt-2">Start Shopping</a>
            </div>
        </template>

        <template x-if="orders.length > 0">
            <div class="list-group">
                <template x-for="order in orders" :key="order.id">
                    <a :href="`/orders/${order.id}`" class="list-group-item list-group-item-action">
                        <div class="d-flex w-100 justify-content-between">
                            <h5 class="mb-1">Order #<span x-text="order.order_number.substring(0, 8) + '...'"></span></h5>
                            <small class="text-muted" x-text="formatDate(order.created_at)"></small>
                        </div>
                        <p class="mb-1" x-text="`Total: ${formatCurrency(order.total_amount)}`"></p>
                        <small>Status: <span class="badge bg-primary" x-text="order.status"></span></small>
                    </a>
                </template>
            </div>
        </template>

        <nav x-show="pagination.totalPages > 1" class="mt-4 d-flex justify-content-center">
            <ul class="pagination">
                <li class="page-item" :class="{ 'disabled': pagination.currentPage <= 1 }"><a class="page-link" href="#" @click.prevent="changePage(pagination.currentPage - 1)">Previous</a></li>
                <li class="page-item active"><a class="page-link" href="#" x-text="pagination.currentPage"></a></li>
                <li class="page-item" :class="{ 'disabled': pagination.currentPage >= pagination.totalPages }"><a class="page-link" href="#" @click.prevent="changePage(pagination.currentPage + 1)">Next</a></li>
            </ul>
        </nav>
    </div>
</div>