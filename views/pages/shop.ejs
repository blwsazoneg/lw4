<div class="container" x-data="shop" x-init="init()">
  <div class="shop-header">
    <h1>Our Products</h1>
  </div>

  <!-- NEW: Simplified Filter Controls -->
  <div class="filter-controls">
    <div class="form-group">
      <label for="productSearch">Search by Product Name</label>
      <input
        type="text"
        id="productSearch"
        x-model="productSearch"
        placeholder="e.g., Wireless Mouse"
      />
    </div>
    <div class="form-group">
      <label for="brandSearch">Search by Brand</label>
      <input
        type="text"
        id="brandSearch"
        x-model="brandSearch"
        placeholder="e.g., Tech Gadgets Co."
      />
    </div>
  </div>

  <!-- Loading State -->
  <div x-show="isLoading" class="loading"><p>Loading products...</p></div>

  <!-- Main Content -->
  <div x-show="!isLoading">
    <!-- Product Grid uses the 'filteredProducts' computed property -->
    <div class="product-grid">
      <template x-for="product in filteredProducts" :key="product.id">
        <div class="product-card">
          <a :href="`/products/${product.id}`" class="product-link">
            <img
              :src="product.image_url || '/images/placeholder.png'"
              alt="Product Image"
              class="product-image"
            />
          </a>
          <div class="product-info">
            <a :href="`/products/${product.id}`" class="product-link">
              <p x-text="product.brand_name" class="product-brand"></p>
              <h3 x-text="product.name" class="product-name"></h3>
            </a>
            <p x-text="formatCurrency(product.price)" class="product-price"></p>
          </div>
          <div class="product-actions">
            <template x-if="!getCartItem(product.id)">
              <button
                @click="addToCart(product.id)"
                class="add-to-cart-btn"
                :disabled="isAddingToCart === product.id"
              >
                <span x-show="isAddingToCart !== product.id">Add to Cart</span>
                <span x-show="isAddingToCart === product.id">Adding...</span>
              </button>
            </template>
            <template x-if="getCartItem(product.id)">
              <div class="quantity-stepper">
                <button @click="updateQuantity(product.id, -1)">-</button>
                <span x-text="getCartItem(product.id).quantity"></span>
                <button @click="updateQuantity(product.id, 1)">+</button>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

    <!-- No Results Message -->
    <div x-show="filteredProducts.length === 0" class="no-results">
      <p>No products found matching your search.</p>
    </div>
  </div>
</div>

<!-- 
    This page no longer needs a dedicated script block.
    We will move the component definition back to the shared footer.
-->
