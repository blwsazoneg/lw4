<% layout('layouts/intro-layout') %>
    <div x-data="cinema" x-init="init()" class="cinema-container-video">
      <div
        x-show="isVideoPlaying"
        x-transition:leave="alpine-fade-slow"
        class="video-overlay"
      >
        <video
          x-ref="introVideo"
          @ended="videoEnded()"
          autoplay
          muted
          playsinline
        >
          <source src="/videos/intro.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

