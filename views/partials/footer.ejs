<!-- views/partials/footer.ejs -->

<!-- STEP 1: Load all library scripts. -->
<script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
<script src="/libs/kingschat-bundle.js"></script>
<!-- Note: We are no longer deferring this -->

<!-- 
    STEP 2: Load Alpine.js NORMALLY. 
    We REMOVED data-alpine-skip-init. We WANT it to start automatically.
-->
<script
  src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
  defer
></script>

<!--
    STEP 3: THE DEFINITIVE FIX.
    We create an inline script block that listens for Alpine's own 'init' event.
    This code is GUARANTEED to run before Alpine scans the page.
-->
<script>
  document.addEventListener("alpine:init", () => {
    // --- ALPINE.JS COMPONENT DEFINITIONS ---

    Alpine.data("navbar", () => ({
      isMenuOpen: false, // By default, the menu is closed

      toggleMenu() {
        this.isMenuOpen = !this.isMenuOpen;
      },
    }));

    // --- UPDATED: Notification Store with Callback ---
    Alpine.store("notifications", {
      isOpen: false,
      title: "",
      message: "",
      onCloseCallback: null, // NEW: A function to run when the modal closes

      show(title, message, onClose = null) {
        this.title = title;
        this.message = message;
        this.onCloseCallback = onClose; // Store the callback
        this.isOpen = true;
      },

      close() {
        this.isOpen = false;
        // If a callback exists, execute it
        if (this.onCloseCallback) {
          this.onCloseCallback();
        }
      },
    });

    // --- Global Cart Store (CORRECTED) ---
    Alpine.store("cart", {
      count: 0,
      fetchCount() {
        if (window.APP_DATA.user) {
          axios
            .get("/api/cart")
            .then((response) => {
              // THE FIX: The count is the number of unique item rows,
              // not the sum of their quantities.
              this.count = response.data.items.length;
            })
            .catch((error) => {
              this.count = 0;
            });
        }
      },
    });

    // --- NEW: Alpine Component for the Modal itself ---
    Alpine.data("notificationModal", () => ({
      // The modal's state is completely driven by the global store
      get isOpen() {
        return Alpine.store("notifications").isOpen;
      },
      get title() {
        return Alpine.store("notifications").title;
      },
      get message() {
        return Alpine.store("notifications").message;
      },
      close() {
        Alpine.store("notifications").close();
      },
    }));

    /**
     * FINAL CORRECTED Alpine Component: cinema
     */
    Alpine.data("cinema", () => ({
      step: 0,
      startSequence() {
        setTimeout(() => {
          this.step = 1;
        }, 500);
        setTimeout(() => {
          this.step = 2;
        }, 3000);
        setTimeout(() => {
          this.step = 3;
        }, 5500);
      },
    }));

    // --- NEW: Global Toast Store ---
    Alpine.store("toast", {
      isVisible: false,
      message: "",
      timer: null,

      show(message) {
        // If a toast is already visible, clear its timer
        if (this.timer) {
          clearTimeout(this.timer);
        }

        this.message = message;
        this.isVisible = true;

        // Set a timer to automatically hide the toast after 3 seconds
        this.timer = setTimeout(() => {
          this.isVisible = false;
        }, 3000);
      },

      close() {
        if (this.timer) {
          clearTimeout(this.timer);
        }
        this.isVisible = false;
      },
    });

    // --- NEW: Alpine Component for the Toast element ---
    Alpine.data("toast", () => ({
      get isVisible() {
        return Alpine.store("toast").isVisible;
      },
      get message() {
        return Alpine.store("toast").message;
      },
      close() {
        Alpine.store("toast").close();
      },
    }));

    Alpine.data("shop", () => ({
      // STATE
      allProducts: [],
      cartItems: [],
      isLoading: true,
      isAddingToCart: null,
      productSearch: "",
      brandSearch: "",

      // METHODS
      init() {
        this.fetchProducts();
        if (window.APP_DATA.user) {
          this.fetchCart();
        }
      },

      fetchProducts() {
        this.isLoading = true;
        axios
          .get("/api/products")
          .then((response) => {
            this.allProducts = response.data;
          })
          .catch((error) => {
            console.error("Error fetching products:", error);
          })
          .finally(() => {
            this.isLoading = false;
          });
      },

      // ===================================================
      // RE-INTEGRATED CART LOGIC
      // ===================================================
      fetchCart() {
        axios
          .get("/api/cart")
          .then((response) => {
            this.cartItems = response.data.items;
            // Update the global cart store count
            Alpine.store("cart").count = this.cartItems.length;
          })
          .catch((error) => {
            // It's normal for a new user to not have a cart, so we don't treat 404 as a hard error.
            if (error.response && error.response.status !== 404) {
              console.error("Error fetching cart:", error);
            }
          });
      },

      getCartItem(productId) {
        return this.cartItems.find((item) => item.product_id === productId);
      },

      addToCart(productId) {
        if (!window.APP_DATA.user) {
          alert("Please log in to add items to your cart.");
          document.querySelector(".kc-web-sdk-btn-s")?.click();
          return;
        }
        this.isAddingToCart = productId;
        axios
          .post("/api/cart/items", { productId: productId, quantity: 1 })
          .then(() => {
            // On success, refetch the entire cart state to ensure UI consistency
            this.fetchCart();
            Alpine.store("toast").show("Item added to cart!");
          })
          .catch((error) => {
            Alpine.store("notifications").show(
              "Error",
              "Could not add item to cart."
            );
          })
          .finally(() => {
            this.isAddingToCart = null;
          });
      },

      updateQuantity(productId, change) {
        const item = this.getCartItem(productId);
        if (!item) return;

        const newQuantity = item.quantity + change;

        if (newQuantity <= 0) {
          // If quantity drops to 0, call the DELETE endpoint
          axios.delete(`/api/cart/items/${productId}`).then(() => {
            this.fetchCart();
          }); // Refetch cart on success
        } else {
          // Otherwise, update the quantity
          axios
            .put(`/api/cart/items/${productId}`, { quantity: newQuantity })
            .then(() => {
              this.fetchCart();
            }); // Refetch cart on success
        }
      },

      formatCurrency(price) {
        return new Intl.NumberFormat("en-ZA", {
          style: "currency",
          currency: "ZAR",
        }).format(price);
      },

      // COMPUTED PROPERTY for client-side filtering
      get filteredProducts() {
        let filtered = this.allProducts;

        if (this.productSearch) {
          const searchLower = this.productSearch.toLowerCase();
          filtered = filtered.filter((p) =>
            p.name.toLowerCase().includes(searchLower)
          );
        }

        if (this.brandSearch) {
          const searchLower = this.brandSearch.toLowerCase();
          filtered = filtered.filter((p) =>
            p.brand_name.toLowerCase().includes(searchLower)
          );
        }

        return filtered;
      },
    }));

    Alpine.data("shoppingCart", () => ({
      // STATE
      items: [],
      isLoading: true,
      error: null,
      isCheckingOut: false,

      // --- STRIPE-SPECIFIC STATE ---
      stripe: null,
      elements: null,
      clientSecret: null,

      // METHODS
      init() {
        this.stripe = Stripe("<%= STRIPE_PUBLISHABLE_KEY %>");
        this.fetchCartItems();
      },

      // METHODS
      fetchCartItems() {
        this.isLoading = true;
        axios
          .get("/api/cart")
          .then((response) => {
            this.items = response.data.items;
            // If cart is not empty, initialize the Stripe Payment Element.
            if (this.items.length > 0) {
              this.initializeStripeElements();
            } else {
              this.isLoading = false; // If cart is empty, no need to load Stripe elements
            }
          })
          .catch((error) => {
            console.error("Error fetching cart items:", error);
            this.error = "Could not load your cart. Please try again.";
            this.isLoading = false;
          });
      },

      async initializeStripeElements() {
        // Fetch a client secret from our backend. This tells Stripe how much to charge.
        try {
          const response = await axios.post(
            "/api/orders/create-payment-intent"
          );
          this.clientSecret = response.data.clientSecret;

          // Create and mount the Stripe Payment Element (the credit card form).
          this.elements = this.stripe.elements({
            clientSecret: this.clientSecret,
          });
          const paymentElement = this.elements.create("payment");
          paymentElement.mount("#payment-element");

          this.isLoading = false; // Now show the page
        } catch (error) {
          console.error("Error initializing payment:", error);
          this.error = "Could not initialize payment. Please refresh the page.";
          this.isLoading = false;
        }
      },

      async checkout() {
        if (this.isCheckingOut || !this.stripe || !this.elements) {
          return;
        }
        this.isCheckingOut = true;

        const { error: stripeError } = await this.stripe.confirmPayment({
          elements: this.elements,
          confirmParams: {
            return_url: `${window.location.origin}/payment-complete`,
          },
          redirect: "if_required",
        });

        if (stripeError) {
          this.showMessage(stripeError.message);
          this.isCheckingOut = false;
          return;
        }

        // --- PAYMENT WAS SUCCESSFUL with Stripe ---
        try {
          const finalizeResponse = await axios.post("/api/orders/finalize");

          // THE FIX:
          // Show the success modal and pass a function to be executed when it closes.
          Alpine.store("notifications").show(
            "Payment Successful!",
            `Your order #${finalizeResponse.data.orderId} has been placed.`,
            () => {
              // This code will only run AFTER the user clicks "Close" on the modal
              this.items = []; // Clear the local cart items
              Alpine.store("cart").fetchCount(); // Update the global navbar counter
            }
          );
        } catch (dbError) {
          this.showMessage(
            "Your payment was successful, but we had an issue creating your order. Please contact support."
          );
        } finally {
          this.isCheckingOut = false;
        }
      },

      removeItem(productId) {
        // Optimistically remove the item from the UI for a fast experience
        const originalItems = [...this.items];
        this.items = this.items.filter((item) => item.product_id !== productId);

        axios
          .delete(`/api/cart/items/${productId}`)
          .then((response) => {
            // Update the global cart count
            Alpine.store("cart").fetchCount();
            Alpine.store("toast").show("Item removed from cart.");
          })
          .catch((error) => {
            // If the API call fails, revert the change in the UI
            this.items = originalItems;
            console.error("Error removing item:", error);
            Alpine.store("notifications").show(
              "Error",
              "Could not remove item. Please try again."
            );
          });
      },

      // checkout() {
      //   this.isCheckingOut = true;
      //   axios
      //     .post("/api/orders/checkout")
      //     .then((response) => {
      //       Alpine.store("notifications").show(
      //         "Checkout Successful!",
      //         `Your order #${response.data.orderId} has been placed.`
      //       );
      //       // Clear the local items and update the global count
      //       this.items = [];
      //       Alpine.store("cart").fetchCount();
      //     })
      //     .catch((error) => {
      //       const errorMessage =
      //         error.response?.data?.error ||
      //         "Checkout failed. Please try again.";
      //       Alpine.store("notifications").show("Checkout Error", errorMessage);
      //     })
      //     .finally(() => {
      //       this.isCheckingOut = false;
      //     });
      // },

      formatCurrency(price) {
        return new Intl.NumberFormat("en-ZA", {
          style: "currency",
          currency: "ZAR",
        }).format(price);
      },

      // COMPUTED PROPERTY for the subtotal
      get subtotal() {
        // Use .reduce() to sum up the total price of all items
        return this.items.reduce((total, item) => {
          return total + item.price * item.quantity;
        }, 0);
      },

      // Helper function to display messages from Stripe
      showMessage(messageText) {
        const messageContainer = document.querySelector("#payment-message");
        messageContainer.classList.remove("hidden");

        messageContainer.textContent = messageText;

        setTimeout(() => {
          messageContainer.classList.add("hidden");
          messageContainer.textContent = "";
        }, 4000); // Hide after 4 seconds
      },
    }));

    /**
     * NEW Alpine Component: productDetail
     * Manages the view for a single product page.
     */
    Alpine.data("productDetail", (productId) => ({
      // STATE
      productId: productId,
      product: null, // Will hold the single product object
      cartItems: [],
      isLoading: true,
      error: null,
      isAddingToCart: false,

      // METHODS
      init() {
        this.fetchProduct();
        if (window.APP_DATA.user) {
          this.fetchCart();
        }
      },

      fetchProduct() {
        this.isLoading = true;
        axios
          .get(`/api/products/${this.productId}`)
          .then((response) => {
            this.product = response.data;
            // Dynamically update the page's <title>
            document.title = this.product.name;
          })
          .catch((error) => {
            console.error("Error fetching product:", error);
            if (error.response && error.response.status === 404) {
              this.error = "This product could not be found.";
            } else {
              this.error = "Could not load product details.";
            }
          })
          .finally(() => {
            this.isLoading = false;
          });
      },

      fetchCart() {
        axios.get("/api/cart").then((response) => {
          this.cartItems = response.data.items;
          Alpine.store("cart").count = this.cartItems.length;
        });
      },

      getCartItem(id) {
        return this.cartItems.find((item) => item.product_id === id);
      },

      addToCart(id) {
        if (!window.APP_DATA.user) {
          alert("Please log in to add items to your cart.");
          document.querySelector(".kc-web-sdk-btn-s")?.click();
          return;
        }
        this.isAddingToCart = true;
        axios
          .post("/api/cart/items", { productId: id, quantity: 1 })
          .then(() => {
            this.fetchCart();
          }) // Refresh cart state on success
          .catch(() => {
            Alpine.store("notifications").show(
              "Error",
              "Could not add item to cart."
            );
          })
          .finally(() => {
            this.isAddingToCart = false;
          });
      },

      updateQuantity(productId, change) {
        const item = this.getCartItem(productId);
        if (!item) return;

        const newQuantity = item.quantity + change;

        if (newQuantity <= 0) {
          // If quantity drops to 0, call the DELETE endpoint
          axios.delete(`/api/cart/items/${productId}`).then((response) => {
            // Always refetch the entire cart to ensure consistency
            this.fetchCart();
          });
        } else {
          // If quantity is > 0, call the new "set quantity" endpoint
          // We will create this PUT endpoint next. It's more reliable.
          axios
            .put(`/api/cart/items/${productId}`, { quantity: newQuantity })
            .then((response) => {
              // Always refetch the entire cart
              this.fetchCart();
            });
        }
      },

      formatCurrency(price) {
        return new Intl.NumberFormat("en-ZA", {
          style: "currency",
          currency: "ZAR",
        }).format(price);
      },
    }));

    Alpine.data("kingsChatLogin", () => ({
      // We no longer need the redirectUrl or setRedirect properties.

      handleLogin() {
        if (typeof kingsChatWebSdk === "undefined" || !kingsChatWebSdk) {
          alert("Error: KingsChat SDK is not available.");
          return;
        }

        // IMPORTANT: Make sure this is your correct Client ID
        const KINGSCHAT_CLIENT_ID = "b2b522e9-d602-402d-b61d-8a50825862da";
        const loginOptions = {
          clientId: KINGSCHAT_CLIENT_ID,
          scopes: ["profile"],
        };

        kingsChatWebSdk
          .login(loginOptions)
          .then((response) => {
            const { accessToken } = response;
            if (!accessToken) {
              throw new Error("SDK did not return an accessToken.");
            }
            return axios.post("/api/auth/kingschat/verify", {
              accessToken: accessToken,
            });
          })
          .then((serverResponse) => {
            console.log("Backend Response:", serverResponse.data);
            alert(`Welcome, ${serverResponse.data.user.firstName}!`);

            // --- THE PERMANENT FIX ---
            // Simply reload the current page. The server will now have the
            // user's session and will render the page in a "logged-in" state.
            window.location.reload();
          })
          .catch((error) => {
            console.error("An error occurred during the login process:", error);
            alert("Login failed. Please check the console for details.");
          });
      },
    }));
    /**
     * NEW Alpine Component: profileCreator
     * Manages the new profile creation page.
     */
    Alpine.data("profileCreator", (user) => ({
      // STATE
      user: user,
      isLoggedIn: user && user.id,
      profileExists: false, // NEW: Track if a profile was loaded
      formData: {
        headline: "",
        bio: "",
        skills: [],
        portfolio_url: "",
        linkedin_url: "",
        age: "",
        field_of_study: "",
        zone: "",
        church: "",
        ministry_position: "",
      },
      skillsInput: "",
      isSaving: false,

      // COMPUTED PROPERTIES (these automatically update)
      get pageTitle() {
        return this.profileExists
          ? "Edit Your Professional Profile"
          : "Create Your Professional Profile";
      },
      get submitButtonText() {
        return this.profileExists ? "Update Profile" : "Create My Profile";
      },

      // METHODS
      init() {
        if (this.isLoggedIn) {
          axios.get("/api/profile/me").then((response) => {
            if (response.data) {
              this.profileExists = true; // A profile was found!
              this.formData = { ...this.formData, ...response.data };
              this.skillsInput = this.formData.skills
                ? this.formData.skills.join(", ")
                : "";
            }
          });
        }
      },
      saveProfile() {
        this.isSaving = true;
        this.formData.skills = this.skillsInput
          .split(",")
          .map((s) => s.trim())
          .filter((s) => s);

        axios
          .post("/api/profile", this.formData)
          .then((response) => {
            this.profileExists = true; // After saving, a profile now exists
            Alpine.store("notifications").show(
              "Profile Saved!",
              "Your profile has been successfully saved."
            );
          })
          .catch((error) => {
            Alpine.store("notifications").show(
              "Error",
              "There was a problem saving your profile. Please try again."
            );
          })
          .finally(() => {
            this.isSaving = false;
          });
      },
    }));

    Alpine.data("profileEditor", () => ({
      // STATE
      formData: {
        headline: "",
        bio: "",
        skills: [],
        portfolio_url: "",
        linkedin_url: "",
      },
      skillsInput: "", // A separate model for the comma-separated skills input
      isLoading: true,
      isSaving: false,
      message: "",
      isError: false,

      // METHODS
      loadProfile() {
        this.isLoading = true;
        axios
          .get("/api/profile/me")
          .then((response) => {
            // If the user has an existing profile, populate the form
            if (response.data) {
              this.formData = response.data;
              // Convert the skills array back into a comma-separated string for the input field
              this.skillsInput = response.data.skills
                ? response.data.skills.join(", ")
                : "";
            }
          })
          .catch((error) => {
            console.error("Error loading profile:", error);
            this.message = "Could not load your profile.";
            this.isError = true;
          })
          .finally(() => {
            this.isLoading = false;
          });
      },

      saveProfile() {
        this.isSaving = true;
        this.message = "";
        this.isError = false;

        // Convert the comma-separated string from the input into an array for the backend.
        this.formData.skills = this.skillsInput
          .split(",")
          .map((skill) => skill.trim())
          .filter((skill) => skill);

        axios
          .post("/api/profile", this.formData)
          .then((response) => {
            this.message = "Profile saved successfully!";
            // Optionally, update formData with the returned profile to get the latest updated_at, etc.
            this.formData = response.data.profile;
          })
          .catch((error) => {
            console.error("Error saving profile:", error);
            this.message = "There was an error saving your profile.";
            this.isError = true;
          })
          .finally(() => {
            this.isSaving = false;
            // Hide the message after a few seconds
            setTimeout(() => {
              this.message = "";
            }, 3000);
          });
      },
    }));

    /**
     * Alpine Component: jobBoard
     * Manages fetching and filtering job listings.
     */
    Alpine.data("jobBoard", (user) => ({
      // STATE
      user: user,
      isLoggedIn: user && user.id, // Check if user is logged in
      jobs: [],
      isLoading: true,
      searchQuery: "",
      tagQuery: "",

      // METHODS
      fetchJobs() {
        this.isLoading = true;
        axios
          .get("/api/jobs")
          .then((response) => {
            this.jobs = response.data;
          })
          .catch((error) => console.error("Error fetching jobs:", error))
          .finally(() => {
            this.isLoading = false;
          });
      },

      // NEW METHOD: Handles the "View & Apply" button click
      handleViewAndApply(jobId) {
        if (this.isLoggedIn) {
          // If logged in, proceed to the job details page
          window.location.href = `/jobs/${jobId}`;
        } else {
          // If not logged in, prompt and trigger the login process
          alert("Please log in to view and apply for jobs.");
          // We can find the login button in the navbar and simulate a click
          // This reuses our existing kingsChatLogin component perfectly.
          document.querySelector(".kc-web-sdk-btn-s")?.click();
        }
      },

      // COMPUTED PROPERTY (with the 'includes' fix)
      get filteredJobs() {
        let filtered = this.jobs;
        if (this.searchQuery) {
          const searchLower = this.searchQuery.toLowerCase();
          filtered = filtered.filter(
            (job) =>
              job.title.toLowerCase().includes(searchLower) ||
              job.company_name.toLowerCase().includes(searchLower)
          );
        }
        if (this.tagQuery) {
          const tagLower = this.tagQuery.toLowerCase();
          filtered = filtered.filter((job) =>
            job.tags.some((tag) => tag.toLowerCase().includes(tagLower))
          );
        }
        return filtered;
      },
    }));

    Alpine.data("jobDetail", (jobId, user) => ({
      // STATE
      jobId: jobId,
      user: user,
      isLoggedIn: user && user.id,
      job: null, // Will hold the job data object
      isLoading: true,
      error: null,
      isApplying: false, // For the button's loading state
      hasApplied: false, // To check if the user already applied

      // METHODS
      fetchJob() {
        this.isLoading = true;
        axios
          .get(`/api/jobs/${this.jobId}`)
          .then((response) => {
            this.job = response.data;
            // After fetching the job, check if the user has applied
            if (this.isLoggedIn) {
              this.checkApplicationStatus();
            }
          })
          .catch((error) => {
            console.error("Error fetching job details:", error);
            if (error.response && error.response.status === 404) {
              this.error = "Sorry, this job could not be found.";
            } else {
              this.error = "An error occurred while loading the job details.";
            }
          })
          .finally(() => {
            this.isLoading = false;
          });
      },

      checkApplicationStatus() {
        // Check the user's application history to see if this job ID is in it
        axios.get(`/api/applications/user/${this.user.id}`).then((response) => {
          const applications = response.data;
          // .some() returns true if any item in the array matches the condition
          if (applications.some((app) => app.job_id === this.jobId)) {
            this.hasApplied = true;
          }
        });
      },

      handleApply() {
        if (!this.isLoggedIn) {
          alert("Please log in to apply for this role.");
          document.querySelector(".kc-web-sdk-btn-s")?.click();
          return;
        }

        if (this.hasApplied) return; // Don't do anything if already applied

        this.isApplying = true;
        axios
          .post("/api/applications", {
            // The backend gets the user_id from the session, we just send the job_id
            job_id: this.jobId,
          })
          .then((response) => {
            this.hasApplied = true; // Mark as applied
            Alpine.store("notifications").show(
              "Application Sent!",
              "Your application has been successfully submitted."
            );
          })
          .catch((error) => {
            let errorMessage =
              "There was an error submitting your application.";
            if (error.response && error.response.data.message) {
              errorMessage = error.response.data.message;
            }
            Alpine.store("notifications").show(
              "Application Error",
              errorMessage
            );
          })
          .finally(() => {
            this.isApplying = false;
          });
      },
    }));

    Alpine.data("innovationForm", () => ({
      // STATE
      formData: {
        title: "",
        submission_text: "",
        ministry_position: "",
      },
      isSubmitting: false,

      // METHODS
      submitIdea() {
        this.isSubmitting = true;

        // FormData is a special object for sending form data, including files.
        const data = new FormData();

        // 1. Append the text fields to the FormData object
        data.append("title", this.formData.title);
        data.append("submission_text", this.formData.submission_text);
        data.append("ministry_position", this.formData.ministry_position);

        // 2. Append the files. We use x-ref to get the file inputs.
        // Check if a file has been selected before appending.
        if (this.$refs.documentInput.files.length > 0) {
          data.append("document", this.$refs.documentInput.files[0]);
        }
        if (this.$refs.videoInput.files.length > 0) {
          data.append("video", this.$refs.videoInput.files[0]);
        }
        // For multiple photos, we need to append them one by one.
        if (this.$refs.photosInput.files.length > 0) {
          for (const file of this.$refs.photosInput.files) {
            data.append("photos", file);
          }
        }

        // 3. Send the request to the backend
        axios
          .post("/api/innovations", data, {
            // This header is crucial for file uploads!
            headers: {
              "Content-Type": "multipart/form-data",
            },
          })
          .then((response) => {
            Alpine.store("notifications").show(
              "Submission Received!",
              "Thank you for sharing your idea with us."
            );
            // Reset the form after successful submission
            this.formData.title = "";
            this.formData.submission_text = "";
            this.formData.ministry_position = "";
            this.$refs.documentInput.value = null;
            this.$refs.photosInput.value = null;
            this.$refs.videoInput.value = null;
          })
          .catch((error) => {
            let errorMessage = "There was an error submitting your idea.";
            if (error.response && error.response.data.message) {
              errorMessage = error.response.data.message;
            }
            Alpine.store("notifications").show(
              "Submission Error",
              errorMessage
            );
          })
          .finally(() => {
            this.isSubmitting = false;
          });
      },
    }));

    // --- NEW: Fetch initial cart count ---
    Alpine.store("cart").fetchCount();

    // Alpine.start();

    // console.log("All components registered.");
  });
</script>
